# Copy this file to ".env" and fill in your own values. NEVER commit ".env".

PORT=4000

# Database (local MySQL or TiDB Cloud). For TiDB Cloud, set DB_SSL=true.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change_me
DB_NAME=ucu_lost_found
DB_SSL=false

# Allowed frontend origin(s), comma-separated (CORS). Example for production:
# CORS_ORIGIN=https://your-app.vercel.app
CORS_ORIGIN=http://localhost:5173

# Session lifetime in days
SESSION_DAYS=7

# Used ONLY by `npm run seed` to create the fictional admin + students.
# Pick your own values; they are never stored in the repository.
SEED_ADMIN_EMAIL=admin@example.test
SEED_PASSWORD=choose_a_strong_password_here
